local function CreatePortal(hit, name)
	if not hit then return end

	local portal = Instance.new("Part")
	portal.Name = name
	portal.Size = Vector3.new(5.5, 7.5, 0.4)
	portal.Anchored = true
	portal.CanCollide = false
	portal.Material = Enum.Material.Neon
	portal.Color = GreenColor
	portal.Transparency = 0.15
	portal.CFrame = CFrame.new(hit.Position + hit.Normal * 0.3, hit.Position + hit.Normal)
	portal.Parent = workspace

	local ring = Instance.new("Part")
	ring.Size = Vector3.new(5.9, 7.9, 0.25)
	ring.Anchored = true
	ring.CanCollide = false
	ring.Material = Enum.Material.Neon
	ring.Color = GreenColor
	ring.Transparency = 0.05
	ring.CFrame = portal.CFrame
	ring.Parent = portal

	local pl = Instance.new("PointLight")
	pl.Color = GreenColor
	pl.Brightness = 4
	pl.Range = 14
	pl.Parent = portal

	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxassetid://241650934"
	pe.Rate = 55
	pe.Lifetime = NumberRange.new(0.5, 1.1)
	pe.Speed = NumberRange.new(1.5, 4)
	pe.Color = ColorSequence.new(GreenColor)
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0)
	})
	pe.Parent = portal

	PlaySound(12222208, 1.2, portal)

	return portal
end

local function SetupTeleport(portal, target)
	if not portal then return end
	portal.Touched:Connect(function(hit)
		local char = hit.Parent
		if char and char:FindFirstChild("Humanoid") and char == plr.Character and target then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				PlaySound(12222216, 1.5, hrp)
				hrp.CFrame = target.CFrame * CFrame.new(0, 0, 3.5)
			end
		end
	end)
end

local function Shoot(isFirst)
	local char = plr.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	PlaySound(12222200, 1.3, barrel)

	local origin = hrp.Position + Vector3.new(0, 1.5, 0)
	local direction = (mouse.Hit.Position - origin).Unit * 400

	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {char, tool}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local result = workspace:Raycast(origin, direction, rayParams)
	if not result then return end

	if isFirst then
		if Portal1 then Portal1:Destroy() end
		Portal1 = CreatePortal(result, "Portal1")
		SetupTeleport(Portal1, Portal2)
		if Portal2 then SetupTeleport(Portal2, Portal1) end
	else
		if Portal2 then Portal2:Destroy() end
		Portal2 = CreatePortal(result, "Portal2")
		SetupTeleport(Portal2, Portal1)
		if Portal1 then SetupTeleport(Portal1, Portal2) end
	end
end

tool.Activated:Connect(function()
	Shoot(true)
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		if tool.Parent == plr.Character then
			Shoot(false)
		end
	end
end)

