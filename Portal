local function PlaySound(id, volume, parent)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. id
	sound.Volume = volume or 1
	sound.Parent = parent or workspace
	sound:Play()
	Debris:AddItem(sound, 3)
end

