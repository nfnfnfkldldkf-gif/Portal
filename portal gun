local function createPortal(hit, name)
	if not hit then return end
	local n = hit.Normal
	local pos = hit.Position + n * 0.28
	local cf = CFrame.lookAt(pos, pos + n)

	local portal = Instance.new("Part")
	portal.Name = name
	portal.Anchored = true
	portal.CanCollide = false
	portal.Size = Vector3.new(6.2, 8.2, 0.28)
	portal.CFrame = cf
	portal.Transparency = 1
	portal.Parent = workspace

	local disc = Instance.new("Part")
	disc.Name = "Disc"
	disc.Anchored = true
	disc.CanCollide = false
	disc.Material = Enum.Material.Neon
	disc.Color = GREEN
	disc.Transparency = 0.25
	disc.Size = Vector3.new(6, 8, 0.22)
	disc.CFrame = cf
	disc.Parent = portal
	local sm = Instance.new("SpecialMesh")
	sm.MeshType = Enum.MeshType.Sphere
	sm.Scale = Vector3.new(1, 1, 0.22)
	sm.Parent = disc

	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.Material = Enum.Material.Neon
	ring.Color = LIME
	ring.Transparency = 0.05
	ring.Size = Vector3.new(0.38, 8.35, 6.35)
	ring.CFrame = cf * CFrame.Angles(0, math.rad(90), 0)
	ring.Parent = portal

	local swirl = Instance.new("Part")
	swirl.Name = "Swirl"
	swirl.Anchored = true
	swirl.CanCollide = false
	swirl.Material = Enum.Material.Neon
	swirl.Color = Color3.fromRGB(10, 90, 25)
	swirl.Transparency = 0.35
	swirl.Size = Vector3.new(5.2, 6.8, 0.18)
	swirl.CFrame = cf
	swirl.Parent = portal
	local sm2 = Instance.new("SpecialMesh")
	sm2.MeshType = Enum.MeshType.Sphere
	sm2.Scale = Vector3.new(1, 1, 0.18)
	sm2.Parent = swirl

	local d1 = Instance.new("Decal")
	d1.Face = Enum.NormalId.Front
	d1.Texture = "rbxassetid://241650934"
	d1.Color3 = GREEN
	d1.Transparency = 0.15
	d1.Parent = swirl
	local d2 = d1:Clone()
	d2.Face = Enum.NormalId.Back
	d2.Parent = swirl

	local pl = Instance.new("PointLight")
	pl.Color = GREEN
	pl.Brightness = 5
	pl.Range = 16
	pl.Parent = disc

	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxassetid://241650934"
	pe.Rate = 70
	pe.Lifetime = NumberRange.new(0.4, 1.1)
	pe.Speed = NumberRange.new(0.4, 2.2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.RotSpeed = NumberRange.new(-180, 180)
	pe.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, LIME),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 80, 30))
	})
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.1),
		NumberSequenceKeypoint.new(1, 0)
	})
	pe.LightEmission = 0.8
	pe.Parent = disc

	PlaySound(12222208, 1.2, portal)
	return portal
end

RunService.Heartbeat:Connect(function(dt)
	for _, p in ipairs({Portal1, Portal2}) do
		if p then
			local swirl = p:FindFirstChild("Swirl")
			if swirl then
				swirl.CFrame = swirl.CFrame * CFrame.Angles(0, 0, math.rad(220 * dt))
			end
		end
	end
end)

local function teleportTo(target)
	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hrp and target) then return end
	PlaySound(12222216, 1.5, hrp)
	hrp.CFrame = target.CFrame * CFrame.new(0, 0, 3.4)
end

local function setupTouch(portal, targetGetter)
	if not portal then return end
	portal.Touched:Connect(function(hit)
		local char = hit.Parent
		if char == plr.Character and char:FindFirstChild("Humanoid") then
			local t = targetGetter()
			if t then teleportTo(t) end
		end
	end)
end

local function shoot(first)
	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	PlaySound(12222200, 1.3, muzzle)

	local origin = hrp.Position + Vector3.new(0, 1.5, 0)
	local dir = (mouse.Hit.Position - origin).Unit * 500
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {char, tool}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local result = workspace:Raycast(origin, dir, params)
	if not result then return end

	if first then
		if Portal1 then Portal1:Destroy() end
		Portal1 = createPortal(result, "Portal1")
		setupTouch(Portal1, function() return Portal2 end)
		if Portal2 then setupTouch(Portal2, function() return Portal1 end) end
	else
		if Portal2 then Portal2:Destroy() end
		Portal2 = createPortal(result, "Portal2")
		setupTouch(Portal2, function() return Portal1 end)
		if Portal1 then setupTouch(Portal1, function() return Portal2 end) end
	end
end

tool.Activated:Connect(function()
	shoot(true)
end)

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 and tool.Parent == plr.Character then
		shoot(false)
	end
end)

