local function PlaySound(id, vol, parent)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Volume = vol or 1
	s.Parent = parent or workspace
	s:Play()
	Debris:AddItem(s, 3)
end

local function part(size, color, mat, parent)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = mat
	p.CanCollide = false
	p.Massless = true
	p.Parent = parent
	return p
end

local function weld(a, b, c0)
	local w = Instance.new("Weld")
	w.Part0 = a
	w.Part1 = b
	w.C0 = c0
	w.Parent = a
	return w
end

